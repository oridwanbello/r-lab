{
  "name": "r-layout",
  "displayName": "R Layout",
  "preview": true,
  "description": "RStudio-inspired multi-pane layout orchestrator for VS Code",
  "version": "0.3.1",
  "publisher": "oridwanbello",
  "icon": "resources/r_logo.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oridwanbello/r-layout.git"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "R Layout",
      "properties": {
        "r-layout.rConsolePath": {
          "type": "string",
          "default": "R",
          "description": "Path or command for the R Console terminal. Examples: 'R', 'radian', or a full path to the Ark kernel."
        }
      }
    },
    "commands": [
      {
        "command": "r-layout.toggleLayout",
        "title": "Toggle R Layout",
        "category": "View"
      },

      {
        "command": "r-layout.maximizeTopRight",
        "title": "Maximize Top Pane",
        "icon": "$(screen-full)"
      },
      {
        "command": "r-layout.restoreRightSplit",
        "title": "Restore Pane Split",
        "icon": "$(screen-normal)"
      },
      {
        "command": "r-layout.sourceFile",
        "title": "Source File to R Console",
        "icon": {
          "light": "resources/run_source_light.svg",
          "dark": "resources/run_source_dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.focusSecondEditorGroup",
        "key": "cmd+j",
        "when": "r-layout.layoutActive"
      },
      {
        "command": "workbench.action.focusThirdEditorGroup",
        "key": "cmd+alt+b",
        "when": "r-layout.layoutActive"
      },
      {
        "command": "r-layout.noop",
        "key": "cmd+shift+i",
        "when": "r-layout.layoutActive"
      },
      {
        "command": "r-layout.sourceFile",
        "key": "cmd+shift+s",
        "when": "r-layout.layoutActive && editorLangId == 'r'"
      },
      {
        "command": "r-layout.sourceFile",
        "key": "ctrl+shift+s",
        "when": "r-layout.layoutActive && editorLangId == 'r'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "r-layout.maximizeTopRight",
          "when": "r-layout.layoutActive && !r-layout.isTopRightMaximized && activeEditorGroupIndex != 1",
          "group": "navigation@1"
        },
        {
          "command": "r-layout.restoreRightSplit",
          "when": "r-layout.layoutActive && r-layout.isTopRightMaximized && activeEditorGroupIndex != 1",
          "group": "navigation@1"
        },
        {
          "command": "r-layout.sourceFile",
          "when": "r-layout.layoutActive && resourceLangId == 'r' && activeEditorGroupIndex == 1",
          "group": "navigation@-100"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
